<UserControl x:Class="BiomentricoHolding.Views.Empleado.RegistrarEmpleado"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F3F4F6">
        <Border Background="White"
                CornerRadius="12"
                Margin="30"
                Padding="30"
                Effect="{DynamicResource DropShadow}"
                VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Título -->
                    <TextBlock Text="📋 Registro de Empleado"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30"/>

                    <!-- Formulario en dos columnas -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Nombres -->
                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="10">
                            <TextBlock Text="Nombres" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtNombres" Height="30" Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Apellidos -->
                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="10">
                            <TextBlock Text="Apellidos" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtApellidos" Height="30" Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Cédula -->
                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="10">
                            <TextBlock Text="Cédula" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtCedula" Height="30" Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Tipo de colaborador -->
                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="10">
                            <TextBlock Text="Tipo de Colaborador" FontWeight="SemiBold"/>
                            <ComboBox x:Name="cbTipoEmpleado" Height="30" Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Empresa -->
                        <StackPanel Grid.Column="0" Grid.Row="2" Margin="10">
                            <TextBlock Text="Empresa" FontWeight="SemiBold"/>
                            <ComboBox x:Name="cbEmpresa" Height="30" Margin="0,5,0,0"
                                      SelectionChanged="cbEmpresa_SelectionChanged"/>
                        </StackPanel>

                        <!-- Sede -->
                        <StackPanel Grid.Column="1" Grid.Row="2" Margin="10">
                            <TextBlock Text="Sede" FontWeight="SemiBold"/>
                            <ComboBox x:Name="cbSede" Height="30" Margin="0,5,0,0"
                                      SelectionChanged="cbSede_SelectionChanged"/>
                        </StackPanel>

                        <!-- Área -->
                        <StackPanel Grid.Column="0" Grid.Row="3" Margin="10">
                            <TextBlock Text="Área" FontWeight="SemiBold"/>
                            <ComboBox x:Name="cbArea" Height="30" Margin="0,5,0,0"/>
                        </StackPanel>

                    </Grid>

                    <!-- Botones alineados al centro -->
                    <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,20,0,0">
                        <Button Content="📸 Capturar Huella"
            Width="150"
            Height="35"
            Margin="0,0,10,0"
            Click="BtnCapturarHuella_Click"/>

                        <Button Content="✅ Registrar"
            Width="150"
            Height="35"
            Background="#007ACC"
            Foreground="White"
            FontWeight="Bold"
            Click="BtnRegistrar_Click"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
